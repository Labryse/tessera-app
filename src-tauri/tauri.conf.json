{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tessera",
  "version": "0.1.2",
  "identifier": "app.tessera.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Tessera",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "backgroundColor": "#141414",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxOTk5RjJFQjZBMzg3N0UKUldSK2g2TzJMcCtad1pKMmwrai9YdXVuemZMaFY0RHdhcW1qb1N6QW9paU9KV2JOTkcrUUp1SnIK",
      "endpoints": [],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Oyun kütüphanesi",
    "publisher": "Tessera",
    "longDescription": "Oyun kütüphanen: mağazalar, emülatörler, süreler ve başarımlar tek yerde.",
    "windows": {
      "nsis": {
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
